{
  "opencollection": "1.0.0",
  "info": {
    "name": "United Rentals Total Control Equipment Locations API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Branch Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.unitedrentals.com/v1/locations",
            "params": [
              {
                "name": "zipCode",
                "value": "",
                "type": "query",
                "description": "Filter by proximity to zip code"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by US state code"
              },
              {
                "name": "radius",
                "value": "",
                "type": "query",
                "description": "Search radius in miles (when using zipCode)"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve United Rentals branch locations by geography or proximity."
        }
      ]
    }
  ],
  "bundled": true
}